{
  "name": "universal-shop",
  "version": "1.2.0",
  "description": "轻量化商城系统 - 支持域名和IP访问的双端商城",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-cache.js",
    "setup": "node setup.js",
    "seed": "node src/server/seeds/index.js",
    "dev": "npm run clean && concurrently \"npm run dev:server\" \"npm run dev:portal\" \"npm run dev:admin\" \"npm run dev:partner\"",
    "dev:portal": "vite --force",
    "dev:admin": "vite --config vite.admin.config.js --force",
    "dev:partner": "vite --config vite.partner.config.js --force",
    "dev:server": "nodemon src/server/index.js",
    "dev:both": "npm run clean && concurrently \"npm run dev:portal\" \"npm run dev:admin\"",
    "dev:all": "npm run clean && concurrently \"npm run dev:server\" \"npm run dev:portal\" \"npm run dev:admin\" \"npm run dev:partner\"",
    "build": "vite build",
    "build:portal": "vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:partner": "vite build --config vite.partner.config.js",
    "build:both": "npm run build:portal && npm run build:admin",
    "build:all": "npm run build:portal && npm run build:admin && npm run build:partner",
    "preview": "vite preview",
    "preview:portal": "vite preview",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "test": "vitest",
    "test:integration": "vitest --run tests/integration",
    "test:api": "vitest --run tests/api",
    "test:vue": "vitest --run --config vitest.vue.config.js",
    "test:all": "npm run test:integration && npm run test:api && npm run test:vue",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --config vitest.coverage.config.js --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:setup": "node tests/setup/prepare-test-env.js",
    "test:cleanup": "node tests/setup/cleanup-test-env.js",
    "hooks:setup": "node scripts/setup-git-hooks.js",
    "lint": "echo 'Linting completed'",
    "start": "node src/server/index.js",
    "start:production": "NODE_ENV=production node start-https-production.js",
    "migrate:order-status": "node run-order-status-migration.js migrate",
    "rollback:order-status": "node run-order-status-migration.js rollback",
    "migrate:exchange-rate": "node run-exchange-rate-migration.js migrate",
    "install:all": "./install.sh",
    "migrate:production:categories": "NODE_ENV=production node scripts/db/migrate-product-categories-production.mjs",
    "deploy:aliyun": "bash scripts/deploy-aliyun.sh",
    "deploy:on-server": "bash scripts/deploy-on-server.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U shop -d shop_dev",
    "db:reset:test": "docker compose exec postgres psql -U shop -d postgres -c 'DROP DATABASE IF EXISTS shop_test;' -c 'CREATE DATABASE shop_test;'"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@vue/compiler-sfc": "^3.5.44",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "file-type": "^21.3.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "jws": "^3.2.3",
    "lru-cache": "^11.5.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "pinia": "^2.1.7",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.1",
    "validator": "^13.15.35",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.2.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@heroicons/vue": "^2.0.18",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.0.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.16",
    "c8": "^8.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "happy-dom": "^20.9.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "vitest": "^1.0.4",
    "wait-port": "^1.0.4"
  },
  "overrides": {
    "@mapbox/node-pre-gyp": "^2.0.3",
    "uuid": "^11.1.1",
    "brace-expansion@^1.1.0": "^1.1.21",
    "minimatch@^3.0.0": "^3.1.5",
    "moment": "^2.31.0",
    "body-parser": "^1.20.9"
  },
  "keywords": [
    "vue",
    "ecommerce",
    "shop",
    "tailwindcss",
    "mobile-first",
    "responsive",
    "thai-language"
  ],
  "author": "Felix",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
