# ===========================================
# 轻量化商城系统 - 环境配置文件（PostgreSQL 版）
# ===========================================

# 应用基础配置
NODE_ENV=production
PORT=3000
APP_NAME=Universal Shop
APP_VERSION=1.2.0

# ---------- 数据库（PostgreSQL，已彻底移除 SQLite） ----------
# 完整连接串。本地用 docker compose 启动 PG 时默认是：
#   postgres://shop:shop@127.0.0.1:5432/shop_dev
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
# 测试库覆盖（NODE_ENV=test 时优先使用）
DATABASE_URL_TEST=postgres://shop:shop@127.0.0.1:5432/shop_test
# 连接池
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_POOL_ACQUIRE_MS=30000
PG_POOL_IDLE_MS=10000
# 云数据库通常需要 SSL：
# PG_SSL=true

# ---------- JWT / 安全 ----------
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h
# 管理端专用密钥：与用户端隔离，防止管理端 token 被用于用户接口（或反之）。
# 生产必填 ≥32 字符；不设会降级到 JWT_SECRET（仅 warn，不阻断启动）。
JWT_ADMIN_SECRET=your-very-secure-admin-jwt-secret-at-least-32-chars
# 合作方专用密钥：同上，生产建议独立配置
JWT_PARTNER_SECRET=your-very-secure-partner-jwt-secret-at-least-32-chars
# 验证码签名密钥；不设则回退到 JWT_SECRET（建议生产单独设置）
CAPTCHA_SECRET=your-very-secure-captcha-secret-32+chars
# 登录失败几次后强制带验证码（默认 5）
LOGIN_CAPTCHA_THRESHOLD=5
# 初始化超级管理员的口令（POST /api/admin/init 必带 X-Init-Secret）
INIT_SECRET=set-a-strong-random-secret-here
# 生产环境创建初始 admin 时必须显式给一个强密码
INIT_ADMIN_PASSWORD=

# ---------- 网络与代理 ----------
# Nginx 等反向代理后必须设置（数字代表跳数；'true' 信任所有；'false' 关闭）
TRUST_PROXY=1
# CORS 白名单（逗号分隔；不设则视为开发环境放行）
ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com

# ---------- helmet/CSP 追加 ----------
# CSP_EXTRA_SCRIPT_SRC=https://cdn.example.com
# CSP_EXTRA_STYLE_SRC=https://fonts.googleapis.com
# CSP_EXTRA_IMG_SRC=https://oss-cn-hongkong.aliyuncs.com
# CSP_EXTRA_CONNECT_SRC=https://api.alipay.com
# CSP_EXTRA_FRAME_SRC=https://*.alipay.com
# CSP_EXTRA_FONT_SRC=https://fonts.gstatic.com

# ---------- 文件上传 ----------
UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# ---------- 系统配置 ----------
DEFAULT_LANGUAGE=th-TH
CURRENCY_SYMBOL=฿
FREE_SHIPPING_THRESHOLD=500
BCRYPT_ROUNDS=10

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_DIR=./logs

# ---------- 开发模式端口 ----------
DEV_PORTAL_PORT=3001
DEV_ADMIN_PORT=3002
DEV_API_PORT=3000

# ---------- Redis（可选） ----------
# 配置后限流、登录失败计数、验证码一次性 nonce、HTTP 缓存、订单超时清扫计数
# 全部切换为跨实例共享（多实例部署必配，否则各实例各算一份，风控被稀释 N 倍）。
# 未配置时退化为进程内内存存储（单实例部署可用）。
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 短信通道（可选） ----------
# 密码重置的 OTP 通过此 webhook 下发；未配置时「忘记密码」入口自动隐藏，
# 且 /api/users/forgot-password 在生产返回 503（不消耗验证码与限流配额）。
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---------- 游客下单反滥用 ----------
# 同一手机号/IP 累计下单次数超过阈值时强制滑块验证码；超过硬上限直接 429。
GUEST_ORDER_CAPTCHA_THRESHOLD=3
GUEST_ORDER_MAX_PER_HOUR=20
GUEST_ORDER_MAX_IP_PER_HOUR=100
# 游客账号自动清理周期（毫秒）
GUEST_ACCOUNT_CLEANUP_INTERVAL_MS=3600000

# ---------- 订单超时清扫 ----------
# 在线支付订单创建后多久未支付即视为超时（分钟）：删除订单并回补库存/积分
ORDER_PENDING_TIMEOUT_MINUTES=10
# 清扫任务执行间隔（毫秒）
ORDER_SWEEP_INTERVAL_MS=60000

# ---------- 数据库细粒度 ----------
# 连接串之外的补充：SSL 连接串（云数据库常用）
# PG_SSL=true
# 空闲事务超时（毫秒）：防止事务泄漏导致连接被长期占用
PG_IDLE_IN_TX_TIMEOUT=10000
# 语句超时（毫秒）：防止慢查询拖垮连接池
PG_STATEMENT_TIMEOUT=30000
# 管理员/运维用的连接串（仅用于建库等一次性操作，勿在应用启动时使用）
# PG_ADMIN_URL=postgres://USER:PASSWORD@HOST:5432/postgres

# ---------- 其他 ----------
# 详细日志（开发用）
# LOG_VERBOSE=true
# 前端 API 基址（独立域名部署时使用；默认同源）
# VUE_APP_API_BASE_URL=https://api.example.com
