# 复制为 deploy.env 后填写（deploy.env 已在 .gitignore，勿提交密钥）
#
# 一键部署（本机）：
#   1) cp scripts/deploy-aliyun.example.sh scripts/deploy-aliyun.sh && chmod +x scripts/deploy-aliyun.sh
#   2) 配置好 deploy.env 后执行 npm run deploy:aliyun
#
# 服务器端实际逻辑见 scripts/deploy-on-server.sh（随 package 包一起上传）
#
# ============================================================================
# ⚠️ 数据库重要变更（2026-05）：本项目已切换到 PostgreSQL，移除 SQLite。
#    旧站升级前必须先在服务器跑一次：
#      bash scripts/migrate-prod-to-postgres.sh \
#           --pg-host <RDS 地址或 127.0.0.1> --pg-port 5432 \
#           --pg-db shop_prod --pg-user shop_app --pg-password '强密码'
#    迁移完会写 .pg_migration_done；后续 deploy-on-server.sh 才放行。
# ============================================================================

# ---------- 阿里云 SSH ----------
DEPLOY_HOST=你的ECS公网IP
DEPLOY_USER=root
# 服务器上项目根目录（须与 PM2 工作目录、Nginx 反代一致）
DEPLOY_PATH=/home/app/universal-shop-v1.2.0
# 可选：私钥路径；留空则使用 ~/.ssh/config 中对应 Host 的配置
# DEPLOY_SSH_KEY=/Users/you/.ssh/your_key

# 部署完成后提示用（健康检查），可填公网域名
DEPLOY_PUBLIC_URL=https://your-shop.example.com

# ---------- 增量部署：是否跳过 npm install ----------
# true（默认）：非首次部署不执行 npm install
# false：每次部署都 npm install --omit=dev（package.json / lock 变更必须）
DEPLOY_UPGRADE_SKIP_NPM=true

# ---------- 增量部署：是否 pg_dump 备份 ----------
# 1 / 0；生产推荐 1。要求服务器装了 postgresql-client（含 pg_dump）。
# 备份输出路径：${DEPLOY_PATH}/database/backups/pg-dump.predeploy.<时间戳>.sql.gz
DEPLOY_PG_BACKUP=1

# ---------- 首次 vs 增量（自动）----------
# 服务器上 DEPLOY_PATH 下若无 .deploy_initialized → 视为首次：
#   - npm install --omit=dev
#   - production-deploy-setup.mjs（建表/补丁/默认配置/区划/默认管理员，不重置已有管理员密码）
#   - PM2 启动/重启后写 .deploy_initialized
# 已存在 .deploy_initialized → 增量部署
# 强制走「首次」：登录服务器删 .deploy_initialized（勿误删 database/）

# ---------- 数据库相关参考 ----------
# 应用 .env 里的 DATABASE_URL 才是真正生效的连接串。形如：
#   DATABASE_URL=postgres://shop_app:<密码>@<RDS或本机>:5432/shop_prod
#   PG_SSL=true            # 阿里云 RDS 公网/SSL 内网常需要
#   PG_POOL_MAX=20         # 视并发量调整
#   TRUST_PROXY=1          # Nginx 反代后强制开
#   ALLOWED_ORIGINS=https://your-shop.example.com
#   JWT_SECRET=...         # 32+ 字符随机
#   INIT_SECRET=...
#   CAPTCHA_SECRET=...
# 完整变量见 env.example。

# Mac 打包注意：仓库内 package.sh 已设 COPYFILE_DISABLE=1。手动 tar 时务必同样设置，
# 否则 Linux 上的 ._XXX 元数据文件可能引入额外问题。
